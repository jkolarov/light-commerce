.git
.github
.claude
.worktrees
.superpowers
node_modules
.next
**/node_modules
# Secrets, wherever they are: a bare `.env` only matches the context root, and `COPY . .` would
# put deploy/demo/.env (the demo's keys and owner password) into the image.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
*.pem
**/*.pem
# The demo's hosting files (its .env, logs, scripts): the image needs none of them.
deploy
logs
**/logs
data/
*.db
*.db-*
docs
demo
tests
coverage
# The end-to-end test's config imports from tests/ (left out above), and next build type-checks it.
playwright.config.ts
playwright-report
test-results
Dockerfile
.dockerignore
compose*.yml
*.md
!messages/**
npm-debug.log*
.DS_Store
