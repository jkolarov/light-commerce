# Copy to deploy/demo/.env (gitignored: this repo is public). Never commit real values.

# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Stripe TEST mode only (sk_test_ / pk_test_).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Written by `deploy/demo/stripe-webhook.py` when it registers the demo's webhook endpoint.
STRIPE_WEBHOOKS_SIGNING_SECRET=

# Printed by `deploy/demo/cloudflare-tunnel.py --token`
TUNNEL_TOKEN=

# The owner account, created by the first seed. The password (random, 20+ characters, for
# example `openssl rand -base64 24`) is needed only then; the nightly reset never reads it.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=

# Loopback host ports (defaults shown)
APP_PORT=3120
MAILPIT_SMTP_PORT=1120
MAILPIT_UI_PORT=8120
