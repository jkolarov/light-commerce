# Copy to .env and fill in. .env is never committed: this repo is public.
# Stories that add a variable add it here, with a harmless default or empty.

# Payload. Generate a secret with: openssl rand -hex 32
PAYLOAD_SECRET=
DATABASE_URI=file:./data/light.db
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Uploaded media. Absolute path; in Docker /app/data/media (on the data volume).
MEDIA_DIR=./data/media

# Email (S07). Locally: Mailpit.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# Stripe, test mode only (S17). Required when the shop is on.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOKS_SIGNING_SECRET=

# Owner account created by the demo seed (S23). The password is needed only to create the account
# (an existing owner keeps theirs): at least 12 characters, random (openssl rand -base64 18).
# `pnpm seed --force` also needs SEED_CONFIRM_WIPE=<database file name> on its own command line:
# never set it here.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
